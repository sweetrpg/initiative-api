BIND_ADDRESS=:8000
ENV=dev
LOG_LEVEL=WARN
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/
AUTH_API_URL=http://api-v1.sweetrpg-auth.svc.cluster.local:8000
USERS_API_URL=http://api-v1.sweetrpg-users.svc.cluster.local:8000
ENTITLEMENTS_API_URL=http://api-v1.sweetrpg-entitlements.svc.cluster.local:8000
# Comma-separated explicit origins; unset disables CORS.
ALLOWED_ORIGINS=

# Auth events (PADR-0039): integration credentials stay off without NATS_URL
NATS_URL=
NATS_DURABLE_NAME=
